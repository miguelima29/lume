CACHE_FILE = os.path.expanduser("~/.cache/lume.json")
ROUTINES_FILE = os.path.expanduser("~/.config/lume/routines.json")
STATE_FILE = os.path.expanduser("~/.config/lume/daemon_state.json")

def read_routines_file():
    if os.path.exists(ROUTINES_FILE):
        try:
            with open(ROUTINES_FILE, "r") as f:
                data = json.load(f)
                if isinstance(data, list):
                    return {"default_brightness": 100, "routines": data}
                return data
        except: pass
    return {"default_brightness": 100, "routines": []}

def write_routines_file(data):
    with open(ROUTINES_FILE, "w") as f:
        json.dump(data, f)

def write_daemon_state(monitor_id, value):
    state = {}
    if os.path.exists(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                state = json.load(f)
        except: pass
    state[monitor_id] = value
    with open(STATE_FILE, "w") as f:
        json.dump(state, f)

# ==========================================
# DAEMON LOGIC (BACKGROUND)
# ==========================================
def apply_routine_daemon(monitor_id, val):
    write_daemon_state(monitor_id, val)
    if monitor_id == "all" or monitor_id.startswith("sysfs_"):
        for path in glob.glob("/sys/class/backlight/*"):
            name = os.path.basename(path)
            if monitor_id == "all" or monitor_id == f"sysfs_{name}":
                try:
                    with open(os.path.join(path, "max_brightness"), "r") as f:
                        max_b = int(f.read().strip())
                    new_b = int((val / 100.0) * max_b)
                    with open(os.path.join(path, "brightness"), "w") as f:
                        f.write(str(new_b))
                except: pass
    
    if monitor_id == "all" or monitor_id.startswith("ddc_"):
        if os.path.exists(CACHE_FILE):
            try:
                with open(CACHE_FILE, "r") as f:
                    data = json.load(f)
                for item in data:
                    if monitor_id == "all" or monitor_id == item['id']:
                        bus = item['bus']
                        subprocess.run(
                            ["ddcutil", "setvcp", "10", str(val), "--bus", str(bus)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                        )
            except: pass

def time_to_mins(t_str):
    if not t_str: return 0
    h, m = map(int, t_str.split(':'))
    return h * 60 + m

def is_active_now(start_str, end_str):
    now = datetime.now()
    now_m = now.hour * 60 + now.minute
    start_m = time_to_mins(start_str)
    end_m = time_to_mins(end_str)
    
    if start_m <= end_m:
        return start_m <= now_m < end_m
    else:
        return now_m >= start_m or now_m < end_m

def run_daemon():
    pid_file = os.path.expanduser("~/.config/lume/daemon.pid")
    os.makedirs(os.path.dirname(pid_file), exist_ok=True)
    with open(pid_file, "w") as f:
        f.write(str(os.getpid()))

    last_minute = -1
    while True:
        now = datetime.now()
        current_minute = now.minute
        
        if current_minute != last_minute:
            data = read_routines_file()
            default_b = data.get("default_brightness", 100)
            routines = data.get("routines", [])
            
            changes_made = False
            for r in routines:
                enabled = r.get("enabled", True)
                was_active = r.get("is_active", False)
                monitor_id = r.get("monitor_id", "all")
                
                is_active = False
                if enabled:
                    if "end_time" in r:
                        is_active = is_active_now(r["start_time"], r["end_time"])
                    elif "time" in r and r.get("time") == now.strftime("%H:%M"):
                        # Legacy single-time trigger backwards compatibility
                        apply_routine_daemon(monitor_id, r.get("brightness", 50))
                        continue
                
                if is_active and not was_active:
                    apply_routine_daemon(monitor_id, r.get("brightness", 50))
                    r["is_active"] = True
                    changes_made = True
                elif not is_active and was_active:
                    apply_routine_daemon(monitor_id, default_b)
                    r["is_active"] = False
                    changes_made = True
                    
            if changes_made:
                write_routines_file(data)
                
            last_minute = current_minute
        
        time.sleep(5)

if len(sys.argv) > 1 and sys.argv[1] == "--daemon":
    run_daemon()
    sys.exit(0)


