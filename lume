            selected_idx = dropdown.get_selected()
            selected_id = monitors[selected_idx][0]
            
            self.routines.append({
                "time": t, 
                "monitor_id": selected_id,
                "brightness": int(scale.get_value()), 
                "enabled": True
            })
            self.save_routines()
            self.load_routines()
            dialog.close()
                
        save_btn.connect("clicked", on_save)
        box.append(save_btn)
        
        toolbar_view.set_content(box)
        dialog.set_content(toolbar_view)
        dialog.present()


class LumeWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Lume")
        self.set_default_size(350, -1) # Auto altura
        self.set_resizable(False)
        self.connect("close-request", self.on_close_request)
        
        toolbar_view = Adw.ToolbarView()
        
        self.header = Adw.HeaderBar()
        
        refresh_btn = Gtk.Button()
        refresh_btn.set_icon_name("view-refresh-symbolic")
        refresh_btn.set_tooltip_text("Reload Monitors")
        refresh_btn.connect("clicked", self.on_refresh_clicked)
        self.header.pack_start(refresh_btn)
        
        routine_btn = Gtk.Button()
        routine_btn.set_icon_name("alarm-symbolic")
        routine_btn.set_tooltip_text("Routines")
        routine_btn.connect("clicked", self.on_routine_clicked)
        self.header.pack_end(routine_btn)
        
        toolbar_view.add_top_bar(self.header)
        
        self.main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        self.main_box.set_margin_start(24)
        self.main_box.set_margin_end(24)
        self.main_box.set_margin_top(24)
        self.main_box.set_margin_bottom(24)
        
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(self.main_box)
        scroll.set_propagate_natural_height(True)
        scroll.set_max_content_height(450)
        
        toolbar_view.set_content(scroll)
        self.set_content(toolbar_view)
        
        self.monitors = {}
        self.sliders = {}
        self.debounces = {}

        self.load_cache_and_sysfs()
        
        threading.Thread(target=self.detect_monitors_bg, daemon=True).start()

    def on_close_request(self, window):
        dialog = Adw.MessageDialog(
            heading="Quit Lume?",
            body="Do you want to close the app and keep the routines active, or quit completely?",
            transient_for=self,
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("close", "Quit Completely")
        dialog.add_response("background", "Keep Routines")
        
        dialog.set_response_appearance("close", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_response_appearance("background", Adw.ResponseAppearance.SUGGESTED)
        
        def on_response(d, response):
            if response == "cancel":
                pass
            elif response == "background":
                self.get_application().quit()
            elif response == "close":
                pid_file = os.path.expanduser("~/.config/lume/daemon.pid")
                if os.path.exists(pid_file):
                    try:
                        with open(pid_file, "r") as f:
                            pid = int(f.read().strip())
                        os.kill(pid, 15)
                    except: pass
                
                autostart_dir = os.path.expanduser("~/.config/autostart")
                desktop_file = os.path.join(autostart_dir, "lume-daemon.desktop")
                if os.path.exists(desktop_file):
                    os.remove(desktop_file)
                self.get_application().quit()
        
        dialog.connect("response", on_response)
        dialog.present()
        return True

    def on_routine_clicked(self, btn):
        win = RoutineDialog(self)
        win.present()

    def on_refresh_clicked(self, btn):
        if hasattr(self, 'loading_label') and self.loading_label.get_parent():
            return
        self.loading_label = Gtk.Label(label="Searching for monitors...")
        self.loading_label.add_css_class("dim-label")
        self.main_box.append(self.loading_label)
        threading.Thread(target=self.detect_monitors_bg, daemon=True).start()

    def load_cache_and_sysfs(self):
        has_monitors = False
        
        for path in glob.glob("/sys/class/backlight/*"):
            name = os.path.basename(path)
            monitor_id = f"sysfs_{name}"
            if monitor_id not in self.monitors:
                self.add_monitor(Monitor(monitor_id, f"Tela Integrada ({name})", "sysfs", path))
                has_monitors = True
        
        if os.path.exists(CACHE_FILE):
            try:
                with open(CACHE_FILE, "r") as f:
                    data = json.load(f)
                for item in data:
                    if item['id'] not in self.monitors:
                        self.add_monitor(Monitor(item['id'], item['name'], "ddcutil", item['bus']))
                        has_monitors = True
            except Exception:
                pass

        if not has_monitors:
            self.loading_label = Gtk.Label(label="Searching for monitors...")
            self.loading_label.add_css_class("dim-label")
            self.main_box.append(self.loading_label)

    def detect_monitors_bg(self):
        try:
            result = subprocess.run(["ddcutil", "detect", "-t"], capture_output=True, text=True)
            lines = result.stdout.split('\n')
            
            detected = []
            seen_monitors = set()
            current_bus = None
            current_drm = None
            
            for line in lines:
                line = line.strip()
                if line.startswith("I2C bus:"):
                    current_bus = line.split("i2c-")[-1].strip()
                elif line.startswith("DRM connector:"):
                    current_drm = line.split(":")[-1].strip()
                elif line.startswith("Monitor:"):
                    name = line.split("Monitor:")[-1].strip()
                    if current_bus and name:
                        uid = f"{current_drm}_{name}"
                        if uid not in seen_monitors:
                            seen_monitors.add(uid)
                            monitor_id = f"ddc_{current_bus}"
                            detected.append({
                                "id": monitor_id,
                                "name": name,
                                "bus": current_bus
                            })
            
            if detected:
                with open(CACHE_FILE, "w") as f:
                    json.dump(detected, f)

            GLib.idle_add(self.update_ui_from_detection, detected)
        except Exception as e:
            print("Falha na detecção ddcutil:", e)

    def update_ui_from_detection(self, detected_monitors):
        if hasattr(self, 'loading_label') and self.loading_label.get_parent():
            self.main_box.remove(self.loading_label)
            
        for item in detected_monitors:
            if item['id'] not in self.monitors:
                self.add_monitor(Monitor(item['id'], item['name'], "ddcutil", item['bus']))
        return False

    def add_monitor(self, monitor):
        self.monitors[monitor.id] = monitor
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        
        label = Gtk.Label(label=monitor.name)
        label.set_halign(Gtk.Align.START)
        label.add_css_class("dim-label")
        label.set_ellipsize(Pango.EllipsizeMode.END)
        box.append(label)
        
        slider_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        
        icon_dim = Gtk.Image.new_from_icon_name("display-brightness-symbolic")
        icon_dim.set_opacity(0.5)
        
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_value(50)
        scale.set_draw_value(True)
        scale.set_value_pos(Gtk.PositionType.TOP)
        scale.set_hexpand(True)
        scale.connect("value-changed", self.on_value_changed, monitor)
        
        icon_bright = Gtk.Image.new_from_icon_name("display-brightness-symbolic")
        
        slider_box.append(icon_dim)
        slider_box.append(scale)
        slider_box.append(icon_bright)
        
        box.append(slider_box)
        self.main_box.append(box)
        self.sliders[monitor.id] = scale
        
        self.fetch_current_brightness(monitor, scale)

    def fetch_current_brightness(self, monitor, scale):
        def worker():
            val = 50
            if monitor.type == 'sysfs':
                try:
                    with open(os.path.join(monitor.bus_or_path, "max_brightness"), "r") as f:
                        max_b = int(f.read().strip())
                    with open(os.path.join(monitor.bus_or_path, "brightness"), "r") as f:
                        curr_b = int(f.read().strip())
                    if max_b > 0:
                        val = int((curr_b / max_b) * 100.0)
                except Exception:
                    pass
            elif monitor.type == 'ddcutil':
                try:
                    result = subprocess.run(["ddcutil", "getvcp", "10", "--bus", str(monitor.bus_or_path), "-t"], capture_output=True, text=True)
                    parts = result.stdout.strip().split()
                    if len(parts) >= 4 and parts[3].isdigit():
                        val = int(parts[3])
                except Exception:
                    pass
            GLib.idle_add(self.update_scale_silently, scale, val)
        threading.Thread(target=worker, daemon=True).start()

    def update_scale_silently(self, scale, value):
        scale.is_updating = True
        scale.set_value(value)
        scale.is_updating = False
        return False

    def on_value_changed(self, scale, monitor):
        if getattr(scale, "is_updating", False):
            return
            
        value = scale.get_value()
        
        if monitor.id in self.debounces:
            GLib.source_remove(self.debounces[monitor.id])
            
        self.debounces[monitor.id] = GLib.timeout_add(150, self._apply_brightness, monitor, value)

    def _apply_brightness(self, monitor, value):
        if monitor.id in self.debounces:
            del self.debounces[monitor.id]
        monitor.set_brightness(value)
        return False

class LumeApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="com.github.lume")

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = LumeWindow(self)
        win.present()

if __name__ == "__main__":
    app = LumeApp()
    app.run(sys.argv)
