class Monitor:
    def __init__(self, id, name, type, bus_or_path):
        self.id = id
        self.name = name
        self.type = type # 'sysfs' or 'ddcutil'
        self.bus_or_path = bus_or_path
        self.q = queue.Queue()
        self.thread = threading.Thread(target=self._worker, daemon=True)
        self.thread.start()

    def set_brightness(self, value):
        while not self.q.empty():
            try: self.q.get_nowait()
            except queue.Empty: break
        self.q.put(int(value))

    def _worker(self):
        while True:
            value = self.q.get()
            if self.type == 'sysfs':
                try:
                    with open(os.path.join(self.bus_or_path, "max_brightness"), "r") as f:
                        max_b = int(f.read().strip())
                    new_b = int((value / 100.0) * max_b)
                    with open(os.path.join(self.bus_or_path, "brightness"), "w") as f:
                        f.write(str(new_b))
                except Exception:
                    pass
            elif self.type == 'ddcutil':
                try:
                    subprocess.run(
                        ["ddcutil", "setvcp", "10", str(value), "--bus", str(self.bus_or_path)],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL
                    )
                except Exception:
                    pass

class RoutineDialog(Adw.Window):
