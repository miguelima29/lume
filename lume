    def ensure_autostart(self):
        autostart_dir = os.path.expanduser("~/.config/autostart")
        os.makedirs(autostart_dir, exist_ok=True)
        desktop_file = os.path.join(autostart_dir, "lume-daemon.desktop")
        
        executable = os.path.abspath(sys.argv[0])
        exec_cmd = f"{sys.executable} {executable} --daemon" if executable.endswith(".py") or "python" in sys.executable else f"{executable} --daemon"
        
        content = f"[Desktop Entry]\nType=Application\nExec={exec_cmd}\nHidden=false\nNoDisplay=false\nX-GNOME-Autostart-enabled=true\nName=Lume Daemon\n"
        with open(desktop_file, "w") as f:
            f.write(content)
            
        pid_file = os.path.expanduser("~/.config/lume/daemon.pid")
        if os.path.exists(pid_file):
            try:
                with open(pid_file, "r") as f:
                    pid = int(f.read().strip())
                os.kill(pid, 0)
                return
            except:
                pass
        
        subprocess.Popen([sys.executable, executable, "--daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def get_monitor_options(self):
        options = [("all", "All Monitors")]
        for path in glob.glob("/sys/class/backlight/*"):
            name = os.path.basename(path)
            options.append((f"sysfs_{name}", f"Built-in ({name})"))
            
        if os.path.exists(CACHE_FILE):
            try:
                with open(CACHE_FILE, "r") as f:
                    data = json.load(f)
                for item in data:
                    options.append((item['id'], item['name']))
            except: pass
        return options

    def load_routines(self):
        while self.list_box.get_first_child():
            self.list_box.remove(self.list_box.get_first_child())
            
        if os.path.exists(ROUTINES_FILE):
            try:
                with open(ROUTINES_FILE, "r") as f:
                    self.routines = json.load(f)
            except: self.routines = []
        else:
            self.routines = []
            
        opts = {k: v for k, v in self.get_monitor_options()}
            
        for i, r in enumerate(self.routines):
            monitor_name = opts.get(r.get("monitor_id", "all"), "Unknown")
            title = f"{r['time']} ➔ {r['brightness']}%"
            subtitle = f"Target: {monitor_name}"
            
            row = Adw.ActionRow(title=title, subtitle=subtitle)
            
            switch = Gtk.Switch()
            switch.set_valign(Gtk.Align.CENTER)
            switch.set_active(r.get("enabled", True))
            switch.connect("notify::active", self.on_toggle, i)
            row.add_suffix(switch)
            
            del_btn = Gtk.Button()
            del_btn.set_icon_name("user-trash-symbolic")
            del_btn.set_valign(Gtk.Align.CENTER)
            del_btn.add_css_class("destructive-action")
            del_btn.connect("clicked", self.on_delete, i)
            row.add_suffix(del_btn)
            
            self.list_box.append(row)

    def save_routines(self):
        with open(ROUTINES_FILE, "w") as f:
            json.dump(self.routines, f)

    def on_toggle(self, switch, param, index):
        self.routines[index]["enabled"] = switch.get_active()
        self.save_routines()
        
    def on_delete(self, btn, index):
        del self.routines[index]
        self.save_routines()
        self.load_routines()

    def on_add_clicked(self, btn):
        dialog = Adw.Window(title="New Routine", transient_for=self, modal=True)
        dialog.set_default_size(350, -1)
        
        toolbar_view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        toolbar_view.add_top_bar(header)
        
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_start(16)
        box.set_margin_end(16)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        
        box.append(Gtk.Label(label="Target Monitor:", halign=Gtk.Align.START))
        monitors = self.get_monitor_options()
        monitor_strings = [m[1] for m in monitors]
        model = Gtk.StringList.new(monitor_strings)
        dropdown = Gtk.DropDown.new(model=model, expression=None)
        box.append(dropdown)
        
        box.append(Gtk.Label(label="Time:", halign=Gtk.Align.START))
        time_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12, halign=Gtk.Align.CENTER)
        
        now = datetime.now()
        
        hour_adj = Gtk.Adjustment(value=now.hour, lower=0, upper=23, step_increment=1)
        hour_spin = Gtk.SpinButton(adjustment=hour_adj, numeric=True, orientation=Gtk.Orientation.VERTICAL)
        hour_spin.set_wrap(True)
        
        min_adj = Gtk.Adjustment(value=now.minute, lower=0, upper=59, step_increment=1)
        min_spin = Gtk.SpinButton(adjustment=min_adj, numeric=True, orientation=Gtk.Orientation.VERTICAL)
        min_spin.set_wrap(True)
        
        colon = Gtk.Label(label=":")
        colon.add_css_class("title-1")
        
        time_box.append(hour_spin)
        time_box.append(colon)
        time_box.append(min_spin)
        box.append(time_box)
        
        box.append(Gtk.Label(label="Brightness:", halign=Gtk.Align.START))
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_value(50)
        scale.set_draw_value(True)
        box.append(scale)
        
        save_btn = Gtk.Button(label="Save Routine")
        save_btn.add_css_class("suggested-action")
        save_btn.set_margin_top(12)
        
        def on_save(b):
            h = int(hour_spin.get_value())
            m = int(min_spin.get_value())
